<Window x:Class="MatRewrite.Ide.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MatOct" Height="760" Width="1200" Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="Mono" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{x:Static ApplicationCommands.Properties}" />
    </Window.InputBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="OnNew" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Open..." Click="OnOpen" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Save" Click="OnSave" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _As..." Click="OnSaveAs" />
                <MenuItem Header="_Close tab" Click="OnCloseTab" InputGestureText="Ctrl+W" />
                <Separator />
                <MenuItem Header="Set _Path..." Click="OnSetPath" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Find..." Click="OnFind" InputGestureText="Ctrl+F" />
                <MenuItem Header="Find and _replace..." Click="OnReplace" InputGestureText="Ctrl+H" />
                <MenuItem Header="_Go to line..." Click="OnGotoLine" InputGestureText="Ctrl+G" />
                <Separator />
                <MenuItem Header="Check _code (lint)" Click="OnLintNow" />
            </MenuItem>
            <MenuItem Header="_Run">
                <MenuItem Header="_Run script" Click="OnRun" InputGestureText="F5" />
                <MenuItem Header="Run _selection" Click="OnRunSelection" InputGestureText="F9" />
                <MenuItem Header="_Interrupt" Click="OnInterrupt" InputGestureText="Ctrl+Break / Ctrl+Shift+C" />
            </MenuItem>
            <MenuItem Header="_Debug">
                <MenuItem Header="_Continue (dbcont)" Click="OnDbCont" InputGestureText="F5 (paused)" />
                <MenuItem Header="Step _over (dbstep)" Click="OnDbStep" InputGestureText="F10" />
                <MenuItem Header="Step _in (dbstep in)" Click="OnDbStepIn" InputGestureText="F11" />
                <MenuItem Header="Step o_ut (dbstep out)" Click="OnDbStepOut" InputGestureText="Shift+F11" />
                <MenuItem Header="_Quit debugging (dbquit)" Click="OnDbQuit" InputGestureText="Shift+F5" />
                <Separator />
                <MenuItem Header="_Toggle breakpoint" Click="OnToggleBreakpoint" InputGestureText="F12" />
                <MenuItem Header="Set co_nditional breakpoint..." Click="OnConditionalBreakpoint" InputGestureText="Shift+F12 / right-click margin" />
                <MenuItem Header="Clear _all breakpoints" Click="OnClearBreakpoints" />
            </MenuItem>
            <MenuItem Header="_Window">
                <MenuItem Header="_Close all figures" Click="OnCloseFigures" />
                <MenuItem Header="C_lear command window" Click="OnClearOutput" />
            </MenuItem>
        </Menu>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Set Path" Click="OnSetPath" ToolTip="Open the Set Path dialog" />
                <Separator />
                <Button Content="&#x2191;" Click="OnFolderUp" ToolTip="Up one level" />
                <Button Content="Browse..." Click="OnBrowseFolder" ToolTip="Browse for folder" />
                <TextBlock Text=" Current Folder: " VerticalAlignment="Center" />
                <TextBox x:Name="FolderBox" Width="560" KeyDown="OnFolderBoxKey" ToolTip="Type a folder and press Enter (cd)" />
            </ToolBar>
        </ToolBarTray>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="Status" Text="Ready" />
            <Separator />
            <TextBlock x:Name="CwdText" />
            <Separator />
            <TextBlock x:Name="LintText" />
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Padding="4,2" Background="#EEE" Text="Current Folder" />
                <ListView x:Name="FolderList" SelectionMode="Extended" MouseDoubleClick="OnFolderItemDoubleClick">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" Click="OnFolderOpen" />
                            <Separator />
                            <MenuItem Header="Add to Path">
                                <MenuItem Header="Selected Folders" Click="OnAddSelectedToPath" />
                                <MenuItem Header="Selected Folders and Subfolders" Click="OnAddSelectedSubToPath" />
                                <MenuItem Header="Current Folder" Click="OnAddCurrentToPath" />
                            </MenuItem>
                            <MenuItem Header="Remove from Path" Click="OnRemoveSelectedFromPath" />
                            <Separator />
                            <MenuItem Header="Show in Explorer" Click="OnShowInExplorer" />
                            <MenuItem Header="Refresh" Click="OnFolderRefresh" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Display}" Width="200" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <TextBlock x:Name="EditorTitle" DockPanel.Dock="Top" Padding="4,2" Background="#EEE" Text="Editor - untitled.m" />
                    <TabControl x:Name="Tabs" SelectionChanged="OnTabChanged" Padding="0" />
                </DockPanel>
                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" />
                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top" Padding="4,2" Background="#EEE" Text="Command Window" />
                    <DockPanel DockPanel.Dock="Bottom">
                        <TextBlock x:Name="PromptText" DockPanel.Dock="Left" Text="&gt;&gt; " FontFamily="Consolas" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <TextBox x:Name="Input" Style="{StaticResource Mono}" PreviewKeyDown="OnInputKey" />
                    </DockPanel>
                    <TextBox x:Name="Output" Style="{StaticResource Mono}" IsReadOnly="True" Background="#FAFAFA"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                </DockPanel>
            </Grid>
            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" />
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top" Padding="4,2" Background="#EEE" x:Name="WorkspaceTitle" Text="Workspace" />
                    <TextBlock DockPanel.Dock="Bottom" Padding="4,2" Foreground="Gray" Text="Double-click a variable to edit it" />
                    <ListView x:Name="WorkspaceList" MouseDoubleClick="OnWorkspaceDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="80" />
                                <GridViewColumn Header="Value" DisplayMemberBinding="{Binding Value}" Width="110" />
                                <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size}" Width="55" />
                                <GridViewColumn Header="Class" DisplayMemberBinding="{Binding Class}" Width="65" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" />
                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top" Padding="4,2" Background="#EEE" Text="Call Stack" />
                    <ListView x:Name="StackList" MouseDoubleClick="OnStackDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Function" DisplayMemberBinding="{Binding Name}" Width="110" />
                                <GridViewColumn Header="Line" DisplayMemberBinding="{Binding Line}" Width="45" />
                                <GridViewColumn Header="File" DisplayMemberBinding="{Binding FileName}" Width="140" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
                <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" />
                <DockPanel Grid.Row="4">
                    <TextBlock DockPanel.Dock="Top" Padding="4,2" Background="#EEE" x:Name="ProblemsTitle" Text="Problems" />
                    <ListView x:Name="ProblemList" MouseDoubleClick="OnProblemDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Line" DisplayMemberBinding="{Binding Line}" Width="45" />
                                <GridViewColumn Header="Message" DisplayMemberBinding="{Binding Text}" Width="270" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
